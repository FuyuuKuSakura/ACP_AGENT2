  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.4.5",
    "vitest": "^1.6.0"
  }
}
