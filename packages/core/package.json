{
  "name": "@dionysus/core",
  "version": "0.1.0",
  "private": true,
  "description": "Host-agnostic business core: adapters / session / persona (zero vscode, zero HTTP/WS deps)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:kimi": "tsx scripts/demo-kimi.ts"
  },
  "dependencies": {
    "@dionysus/protocol": "^0.1.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "~5.4.5",
    "vitest": "^1.6.0"
  }
}
