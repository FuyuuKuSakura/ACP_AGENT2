{
  "name": "@dionysus/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Message types + zod schemas shared by webview, mobile and core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
